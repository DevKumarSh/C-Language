<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp">

    <EditText
        android:id="@+id/etPassengers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Number of Passengers"
        android:inputType="number" />

    <EditText
        android:id="@+id/etPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Ticket Price"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculate Fare" />

    <TextView
        android:id="@+id/txtResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="20sp"
        android:gravity="center" />

</LinearLayout>



package com.example.myapp;

import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.EditText;
import android.widget.TextView;

import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText etPassengers, etPrice;
    Button btnCalculate;
    TextView txtResult;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        etPassengers = findViewById(R.id.etPassengers);
        etPrice = findViewById(R.id.etPrice);
        btnCalculate = findViewById(R.id.btnCalculate);
        txtResult = findViewById(R.id.txtResult);

        btnCalculate.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {

                String passengersText =
                        etPassengers.getText().toString().trim();

                String priceText =
                        etPrice.getText().toString().trim();

                if (passengersText.isEmpty() || priceText.isEmpty()) {
                    txtResult.setText("Please enter all details.");
                    return;
                }

                try {
                    int passengers = Integer.parseInt(passengersText);
                    double price = Double.parseDouble(priceText);

                    if (passengers <= 0 || price < 0) {
                        txtResult.setText("Enter valid values.");
                        return;
                    }

                    double total = passengers * price;
                    double discount = 0;

                    if (passengers >= 5) {
                        discount = total * 0.10;
                    }

                    double finalAmount = total - discount;

                    txtResult.setText(
                            "Total Amount: Rs. " + String.format("%.2f", total)
                            + "\nDiscount: Rs. " + String.format("%.2f", discount)
                            + "\nFinal Amount: Rs. " + String.format("%.2f", finalAmount)
                    );

                } catch (NumberFormatException e) {
                    txtResult.setText("Please enter valid numbers.");
                }
            }
        });
    }
}
